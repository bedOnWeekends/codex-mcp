ORCH_ENVIRONMENT=development
ORCH_LOG_LEVEL=info
ORCH_SERVER_HOST=127.0.0.1
ORCH_SERVER_PORT=8000
ORCH_MCP_PATH=/mcp
ORCH_MCP_JSON_RESPONSE=true
ORCH_MCP_STATELESS_HTTP=true
ORCH_DATABASE_URL=postgresql+asyncpg://orchestrator:orchestrator@127.0.0.1:5433/orchestrator
ORCH_DATABASE_ECHO=false
ORCH_RUNTIME_DIR=runtime
ORCH_MAX_PARALLEL_WORKERS=3
ORCH_MAX_AGENTS_PER_RUN=4
ORCH_MAX_TOKENS_PER_RUN=250000
ORCH_MAX_DEPENDENCY_SUMMARY_CHARS=1200
ORCH_SCOUT_REVIEW_CONFIDENCE_THRESHOLD=0.72
ORCH_MAX_ATTEMPTS_PER_TASK=2
ORCH_MAX_REPLANS=1
ORCH_MAX_FIX_CYCLES=2
ORCH_WORKER_POLL_INTERVAL_SECONDS=1
ORCH_WORKER_ID=local-worker
ORCH_CODEX_MODE=fake
ORCH_FAKE_CODEX_DELAY_SECONDS=0
ORCH_CODEX_MODEL_CHEAP=gpt-5.6-luna
ORCH_CODEX_MODEL_DEFAULT=gpt-5.6-terra
ORCH_CODEX_MODEL_CRITICAL=gpt-5.6-sol
ORCH_CODEX_EFFORT_SCOUT=low
ORCH_CODEX_EFFORT_PLAN=medium
ORCH_CODEX_EFFORT_DEFAULT=high
ORCH_CODEX_EFFORT_CRITICAL=medium
ORCH_CODEX_EFFORT_RETRY=high
ORCH_CODEX_APPROVAL_POLICY=deny_all
ORCH_CODEX_SANDBOX_MODE=workspace-write
ORCH_CODEX_PRICE_CHEAP_INPUT_PER_MTOK=1.00
ORCH_CODEX_PRICE_CHEAP_CACHED_INPUT_PER_MTOK=0.10
ORCH_CODEX_PRICE_CHEAP_OUTPUT_PER_MTOK=6.00
ORCH_CODEX_PRICE_DEFAULT_INPUT_PER_MTOK=2.50
ORCH_CODEX_PRICE_DEFAULT_CACHED_INPUT_PER_MTOK=0.25
ORCH_CODEX_PRICE_DEFAULT_OUTPUT_PER_MTOK=15.00
ORCH_CODEX_PRICE_CRITICAL_INPUT_PER_MTOK=5.00
ORCH_CODEX_PRICE_CRITICAL_CACHED_INPUT_PER_MTOK=0.50
ORCH_CODEX_PRICE_CRITICAL_OUTPUT_PER_MTOK=30.00
ORCH_PROJECTED_CALL_COST_USD_CHEAP=0.05
ORCH_PROJECTED_CALL_COST_USD_DEFAULT=0.45
ORCH_PROJECTED_CALL_COST_USD_CRITICAL=1.00
ORCH_BUDGET_RESERVE_USD=0.05
ORCH_VERIFICATION_TIMEOUT_SECONDS=300
ORCH_WORKTREE_BRANCH_PREFIX=orchestrator/run-
ORCH_GITHUB_PUBLISH_MODE=fake
ORCH_GITHUB_TOKEN=
ORCH_GITHUB_REMOTE_NAME=origin
ORCH_GITHUB_API_URL=https://api.github.com
ORCH_GITHUB_API_VERSION=2026-03-10
ORCH_GITHUB_REQUEST_TIMEOUT_SECONDS=30
